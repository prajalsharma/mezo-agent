{
  "name": "mezo-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Mezo conversational agent \u2014 Telegram bot for the Mezo Bitcoin-DeFi stack (Phase 1: wallet, deposit QR, portfolio, swap)",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node --import tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "genkey": "tsx scripts/genkey.ts",
    "smoke": "tsx scripts/smoke.ts",
    "policycheck": "tsx scripts/policycheck.ts",
    "accesscheck": "TELEGRAM_ALLOWED_USER_IDS=555 tsx scripts/accesscheck.ts",
    "swapcheck": "MEZO_NETWORK=mainnet tsx scripts/swapcheck.ts",
    "phasecheck": "KEEPER_ENABLED=true tsx scripts/phasecheck.ts",
    "contracts:test": "cd contracts && forge test",
    "verifyaddrs": "tsx scripts/verifyaddrs.ts",
    "discover": "tsx scripts/discover.ts",
    "phaseaudit": "tsx scripts/phaseaudit.ts",
    "simcheck": "tsx scripts/simcheck.ts",
    "auditfixes": "tsx scripts/auditfixes.ts",
    "exportcheck": "tsx scripts/exportcheck.ts",
    "e2e": "MEZO_NETWORK=testnet tsx scripts/e2e.ts",
    "menucheck": "tsx scripts/menucheck.ts",
    "referralcheck": "tsx scripts/referralcheck.ts",
    "parsecheck": "node --import tsx scripts/parsecheck.ts",
    "deployfeerouter": "tsx scripts/deployfeerouter.ts",
    "feeroutercheck": "tsx scripts/feeroutercheck.ts",
    "feeverify": "tsx scripts/feeverify.ts",
    "feerouterconfig": "tsx scripts/feerouterconfig.ts",
    "deadendcheck": "tsx scripts/deadendcheck.ts",
    "routercompat": "tsx scripts/routercompat.ts",
    "productcopy": "tsx scripts/productcopy.ts",
    "flowcheck": "tsx scripts/flowcheck.ts",
    "conformance": "tsx scripts/conformance.ts",
    "confirmcheck": "tsx scripts/confirmcheck.ts",
    "storecheck": "tsx scripts/storecheck.ts",
    "reviewcheck": "tsx scripts/reviewcheck.ts",
    "followupcheck": "tsx scripts/followupcheck.ts",
    "capcheck": "tsx scripts/capcheck.ts",
    "checkall": "tsx scripts/checkall.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.65.0",
    "dotenv": "^16.4.5",
    "grammy": "^1.30.0",
    "qrcode": "^1.5.4",
    "tsx": "^4.19.0",
    "viem": "^2.54.6",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "@types/qrcode": "^1.5.5",
    "typescript": "^5.6.0"
  }
}
