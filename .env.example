# ─── Telegram ────────────────────────────────────────────────────────────────
# Create a bot with @BotFather and paste the token here.
TELEGRAM_BOT_TOKEN=

# ─── Network ─────────────────────────────────────────────────────────────────
# "testnet" (Matsnet, chain 31611) or "mainnet" (chain 31612).
# Phase 1 development MUST run against testnet.
MEZO_NETWORK=testnet

# ─── Custody (Tier 3 stopgap — see README "Trust model") ─────────────────────
# 32-byte hex key used for AES-256-GCM envelope encryption of private keys at rest.
# Generate with: npm run genkey
# PRODUCTION: this is replaced by a KMS/HSM/MPC signer. The private key is never
# stored in plaintext, never logged, and never sent to any LLM provider.
MASTER_ENCRYPTION_KEY=

# ─── LLM (optional in Phase 1) ───────────────────────────────────────────────
# The LLM is a *parser only* — it never holds keys, never builds calldata, and
# never has authority to move funds. If unset, the bot falls back to a
# deterministic command/regex parser.
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# ─── Datastore (Phase 1 default: file-backed) ────────────────────────────────
# Production target is Postgres + Redis (see architecture §9). For local dev the
# store is a JSON file under ./data. Encrypted key material only; never plaintext.
DATA_DIR=./data
