# ─── Telegram ────────────────────────────────────────────────────────────────
# Create a bot with @BotFather and paste the token here.
TELEGRAM_BOT_TOKEN=

# Restrict who may talk to the bot. Comma-separated Telegram user IDs.
# A bot is publicly reachable by username as soon as it exists, so for local
# development set this to YOUR id — otherwise a stranger can onboard a wallet on
# your instance. Find your id by starting the bot and messaging it: the denial is
# logged as access.denied {telegramId}. Empty => open to everyone.
TELEGRAM_ALLOWED_USER_IDS=

# ─── Network ─────────────────────────────────────────────────────────────────
# "testnet" (Matsnet, chain 31611) or "mainnet" (chain 31612).
# Both networks have verified pools (BTC/MUSD, MUSD/mUSDC, MUSD/mUSDT); quotes
# and swap execution work on both. Test on Matsnet first (faucet funds).
MEZO_NETWORK=testnet
# Optional RPC override. The built-in mainnet default is validationcloud (the
# docs' imperator endpoint rejects JSON-RPC POSTs). Leave blank to use defaults.
MEZO_RPC_URL=

# ─── Confirmed contract addresses (optional; enable gated features) ──────────
# These are NOT invented in code. Supply the canonical/confirmed address to turn
# a feature on. Empty => the feature stays gated (quote-only / no upgrade).
#   MEZO_ROUTER_ADDRESS  — enables on-chain swap EXECUTION (token↔token).
#   DELEGATE7702_ADDRESS — enables the EIP-7702 /upgrade (deploy contracts/, then set).
MEZO_ROUTER_ADDRESS=
DELEGATE7702_ADDRESS=

# Market context (researched July 2026): every surviving trading bot charges 1%
# gross (Axiom $714M lifetime, GMGN $236M, Trojan $225M — all at 1%); referred
# users universally pay ~0.9%. Recommended: AGENT_FEE_BPS=100 with the default
# referred discount.
#   AGENT_FEE_BPS=100            # 1% headline swap/zap fee (hard cap 100)
#   AGENT_REFERRED_FEE_BPS=90    # optional; defaults to 90% of AGENT_FEE_BPS

# FeeRouter — atomic swap+fee (contracts/src/FeeRouter.sol). When set, swaps
# route through it so the agent fee is collected in the SAME transaction as the
# swap: failed swap = no fee, successful swap = fee guaranteed. Deploy with
# `npm run deployfeerouter -- --deploy`, then paste the printed address here.
# Keep the contract's feeBps in sync with AGENT_FEE_BPS (owner setConfig).
FEE_ROUTER_ADDRESS=

# Generic per-contract override: MEZO_ADDR_<CONTRACTKEY>. Any ContractKey works
# (case-insensitive), so a confirmed address activates or overrides its surface
# with no code change. Malformed values are ignored, not passed on.
# Seeded + on-chain verified already (override only if Mezo redeploys):
#   Borrow suite, Router, PoolFactory, VotingEscrowBTC, Voter,
#   RewardsDistributor — see `npm run verifyaddrs` / `npm run verifyve`.
# Still awaiting a published address:
#   MEZO_ADDR_VOTINGESCROWMEZO=   # Lock veMEZO (no documented contract yet)
#   MEZO_ADDR_MATCHBOX=           # community project (matchbox.markets)
#   MEZO_ADDR_MARKET=             # Mezo Market (no published contract)

# ─── Custody (Tier 3 stopgap — see README "Trust model") ─────────────────────
# 32-byte hex key used for AES-256-GCM envelope encryption of private keys at rest.
# Generate with: npm run genkey
# PRODUCTION: this is replaced by a KMS/HSM/MPC signer. The private key is never
# stored in plaintext, never logged, and never sent to any LLM provider.
MASTER_ENCRYPTION_KEY=

# ─── LLM (optional) ──────────────────────────────────────────────────────────
# The LLM is a *parser only* — it never holds keys, never builds calldata, and
# never has authority to move funds. If unset (or if the call fails / runs out of
# credit), the bot falls back to a deterministic command/regex parser, so the bot
# never breaks — it just loses free-form phrasing understanding.
#
# Pick ONE provider:
#
#  • gemini    — Google AI Studio. Has a FREE tier (no credit card). Best way to
#                get real conversational parsing at zero cost. Get a key at
#                https://aistudio.google.com/apikey
#  • anthropic — Claude. Paid (pay-as-you-go). Highest quality; use claude-haiku
#                for the cheapest option.
LLM_PROVIDER=gemini

# --- Gemini (free) ---
# gemini-flash-latest auto-tracks the current free flash model. Pin a specific
# version (e.g. gemini-2.0-flash) only if you need reproducibility.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# --- Anthropic (paid) — only needed if LLM_PROVIDER=anthropic ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# ─── Monetization (optional; disclosed in-bot via /fees) ─────────────────────
# Small fee on swaps/zaps, taken from the INPUT token and shown on every
# confirmation before the user approves. Hard-capped at 100 bps (1%) in code.
# Leave AGENT_FEE_BPS=0
# Fee (bps) on borrow / vault-deposit / lock (Mezo-approved). 10 = 0.1%. Capped 100.
AGENT_TXN_FEE_BPS=0 or the recipient empty to charge nothing.
AGENT_FEE_BPS=0
# Fee (bps) on borrow / vault-deposit / lock (Mezo-approved). 10 = 0.1%. Capped 100.
AGENT_TXN_FEE_BPS=0
AGENT_FEE_RECIPIENT=
# Free-text note shown under /fees for automation pricing (DCA / auto-compound).
AGENT_AUTOMATION_NOTE=
# Referral revenue share: % of the agent fee paid to whoever referred the trader
# (deep-link t.me/<bot>?start=<id>). Shown in /referral and /fees. Default 30.
AGENT_REFERRAL_SHARE_PCT=30

# ─── Automation keeper ───────────────────────────────────────────────────────
# Global kill-switch for ALL scheduled execution (DCA, epoch auto-compound).
KEEPER_ENABLED=false

# ─── Datastore (Phase 1 default: file-backed) ────────────────────────────────
# Production target is Postgres + Redis (see architecture §9). For local dev the
# store is a JSON file under ./data. Encrypted key material only; never plaintext.
DATA_DIR=./data
