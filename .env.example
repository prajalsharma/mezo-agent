# ─── Telegram ────────────────────────────────────────────────────────────────
# Create a bot with @BotFather and paste the token here.
TELEGRAM_BOT_TOKEN=

# Restrict who may talk to the bot. Comma-separated Telegram user IDs.
# A bot is publicly reachable by username as soon as it exists, so for local
# development set this to YOUR id — otherwise a stranger can onboard a wallet on
# your instance. Find your id by starting the bot and messaging it: the denial is
# logged as access.denied {telegramId}. Empty => open to everyone.
TELEGRAM_ALLOWED_USER_IDS=

# ─── Network ─────────────────────────────────────────────────────────────────
# "testnet" (Matsnet, chain 31611) or "mainnet" (chain 31612).
# Swap QUOTES need mainnet (that's where the DEX pools live); testnet has no pools.
MEZO_NETWORK=testnet
# Optional RPC override. The built-in mainnet default is validationcloud (the
# docs' imperator endpoint rejects JSON-RPC POSTs). Leave blank to use defaults.
MEZO_RPC_URL=

# ─── Confirmed contract addresses (optional; enable gated features) ──────────
# These are NOT invented in code. Supply the canonical/confirmed address to turn
# a feature on. Empty => the feature stays gated (quote-only / no upgrade).
#   MEZO_ROUTER_ADDRESS  — enables on-chain swap EXECUTION (token↔token).
#   DELEGATE7702_ADDRESS — enables the EIP-7702 /upgrade (deploy contracts/, then set).
MEZO_ROUTER_ADDRESS=
DELEGATE7702_ADDRESS=

# ─── Custody (Tier 3 stopgap — see README "Trust model") ─────────────────────
# 32-byte hex key used for AES-256-GCM envelope encryption of private keys at rest.
# Generate with: npm run genkey
# PRODUCTION: this is replaced by a KMS/HSM/MPC signer. The private key is never
# stored in plaintext, never logged, and never sent to any LLM provider.
MASTER_ENCRYPTION_KEY=

# ─── LLM (optional in Phase 1) ───────────────────────────────────────────────
# The LLM is a *parser only* — it never holds keys, never builds calldata, and
# never has authority to move funds. If unset, the bot falls back to a
# deterministic command/regex parser.
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# ─── Monetization (optional; disclosed in-bot via /fees) ─────────────────────
# Small fee on swaps/zaps, taken from the INPUT token and shown on every
# confirmation before the user approves. Hard-capped at 100 bps (1%) in code.
# Leave AGENT_FEE_BPS=0 or the recipient empty to charge nothing.
AGENT_FEE_BPS=0
AGENT_FEE_RECIPIENT=
# Free-text note shown under /fees for automation pricing (DCA / auto-compound).
AGENT_AUTOMATION_NOTE=

# ─── Automation keeper ───────────────────────────────────────────────────────
# Global kill-switch for ALL scheduled execution (DCA, epoch auto-compound).
KEEPER_ENABLED=false

# ─── Datastore (Phase 1 default: file-backed) ────────────────────────────────
# Production target is Postgres + Redis (see architecture §9). For local dev the
# store is a JSON file under ./data. Encrypted key material only; never plaintext.
DATA_DIR=./data
