# ---- Telegram gateway ----
# Get a token from @BotFather. Without it, run `npm run demo` to exercise the pipeline offline.
TELEGRAM_BOT_TOKEN=

# ---- Chain (Mezo Matsnet testnet) ----
MEZO_CHAIN_ID=31611
MEZO_RPC_URL=https://rpc.test.mezo.org

# ---- Reasoning / LLM adapter (provider-agnostic, all optional) ----
# If no provider key is set, the adapter falls back to a deterministic rule-based parser.
LLM_PROVIDER=fallback            # one of: fallback | anthropic | openai
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
LLM_MODEL=

# ---- Signer / custody (Tier-3 contained fallback for local dev ONLY) ----
# NEVER commit a real key. In production this lives in KMS/HSM/MPC, addressed by reference.
# Leave empty to run in dry-run mode (simulate + confirm, but do not submit).
SIGNER_PRIVATE_KEY=

# ---- App-level policy (defense-in-depth layer 1) ----
# Confirmation is still always required; these are hard caps enforced before signing.
POLICY_MAX_BTC_PER_ACTION=0.25
POLICY_MAX_MUSD_PER_ACTION=25000
POLICY_DAILY_BTC_CAP=1.0
POLICY_WATCH_ONLY=false
